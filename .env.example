# Copy to .env and adjust:  cp .env.example .env
#
# Values below are INSECURE demo placeholders. They are only needed by the
# Docker quickstart (`docker compose up --build`) — the in-memory demo mode and
# local `npm run dev` flows fall back to built-in defaults (see src/config.ts).
# For anything real, set a long random JWT_SECRET and your own admin credentials.
JWT_SECRET=change-me-in-production-use-a-long-random-string!!
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=admin-demo-123
